{
  "name": "pcc-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "Desktop packaging (Electron) for Project Control Center. Wraps the self-contained index.html built by ../build.js in a native window — dev-only tooling, not part of the shipped single-file app.",
  "author": "Aditya Abhyankar",
  "main": "electron/main.js",
  "scripts": {
    "electron:dev": "node scripts/copy-app.js && electron .",
    "electron:build": "node scripts/copy-app.js && electron-builder"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.pcc.projectcontrolcenter",
    "productName": "Project Control Center",
    "publish": null,
    "icon": "icons/pcc-icon-source.png",
    "files": [
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "synopsis": "Solo-developer, offline-first project/portfolio management"
    }
  }
}
