{
  "name": "project-control-center",
  "private": true,
  "version": "1.2.0",
  "description": "Offline-first project and portfolio management, packaged as a native desktop app.",
  "author": "Aditya Abhyankar",
  "main": "electron/main.js",
  "desktopName": "project-control-center.desktop",
  "scripts": {
    "electron:dev": "node scripts/copy-app.js && electron .",
    "electron:build": "node scripts/copy-app.js && electron-builder"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.pcc.projectcontrolcenter",
    "productName": "Project Control Center",
    "publish": null,
    "icon": "icons/pcc-icon-source.png",
    "files": [
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "synopsis": "Solo-developer, offline-first project/portfolio management",
      "syncDesktopName": true
    }
  }
}
